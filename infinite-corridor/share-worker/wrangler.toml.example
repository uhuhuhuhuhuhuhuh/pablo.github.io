name = "infinite-corridor-share"
main = "src/index.js"
compatibility_date = "2026-08-12"

[vars]
APP_URL = "https://uhuhuhuhuhuhuhuh.github.io/pablo.github.io/infinite-corridor"
ALLOWED_ORIGIN = "https://uhuhuhuhuhuhuhuh.github.io"
# Optional after assigning a custom Worker route/domain:
# PUBLIC_BASE_URL = "https://corridor.example"

[[d1_databases]]
binding = "DB"
database_name = "infinite-corridor-share"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
